{
    "app_name": "Agentic Judge API",
    "environment": "development",
    "version": "0.1.0",
    "debug": true,
    "paths": {
        "prompts_base_path": "src/prompts",
        "nodes_base_path": "src/nodes",
        "logs_path": "logs"
    },
    "redis": {
        "url": "redis://127.0.0.1:6379/0",
        "session_ttl": 3600
    },
    "nodes": {
        "intent_node": {
            "model_name": "gemini-2.5-flash",
            "system_prompt": "intent_system",
            "user_prompt": "intent_user"
        },
        "response_node": {
            "model_name": "gemini-2.5-flash",
            "system_prompt": "response_system",
            "user_prompt": "response_user"
        }
    },
    "llm_models": {
        "google": {
            "api_key": "YOUR_GOOGLE_API_KEY_HERE",
            "chat_models": {
                "gemini-2.5-flash": {
                    "temperature": 0.5,
                    "max_tokens": 1024
                },
                "gemini-2.5-pro": {
                    "temperature": 0.7,
                    "max_tokens": 2048
                }
            },
            "embedding_models": {
                "text-embedding-004": {
                    "dimensions": 768
                }
            }
        },
        "ollama": {
            "chat_models": {
                "mistral": {
                    "temperature": 0.0,
                    "base_url": "http://localhost:11434"
                },
                "llama3": {
                    "temperature": 0.7,
                    "base_url": "http://localhost:11434"
                }
            },
            "embedding_models": {
                "nomic-embed-text": {
                    "base_url": "http://localhost:11434"
                }
            }
        }
    }
}